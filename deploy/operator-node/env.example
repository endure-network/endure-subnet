# Copy to deploy/operator-node/.env on the host and chmod 0600. Never commit it.
# Images follow the release channel named after SERVING_STAGE (:testnet or
# :mainnet); there is nothing to set per release. To hold this host on one
# release, pin both to registry digests of that release:
#   VALIDATOR_IMAGE=ghcr.io/endure-network/endure-subnet-validator@sha256:<digest>
#   MINER_IMAGE=ghcr.io/endure-network/endure-subnet-miner@sha256:<digest>

NETUID=0
# CHAIN=finney with SERVING_STAGE=mainnet for mainnet; the stage must match the chain.
CHAIN=test
SERVING_STAGE=testnet
EXTERNAL_IP=0.0.0.0
VALIDATOR_WALLET_ROOT=/path/to/validator-only-wallets
MINER_WALLET_ROOT=/path/to/miner-only-wallets
WALLET_NAME=replace-me
VALIDATOR_HOTKEY=replace-me
MINER_HOTKEY=replace-me
VALIDATOR_AXON_OVERRIDES=

MIN_MINER_STAKE=0
EPOCH_LENGTH=100
MARKET_DATA_ENDPOINT=wss://archive.chain.opentensor.ai:443
