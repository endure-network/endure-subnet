# Optional combined validator + miner example for mainnet.
# Copy to deploy/operator-node/.env on the host and chmod 0600. Never commit it.
VALIDATOR_IMAGE=ghcr.io/endure-network/endure-subnet-validator:prod
MINER_IMAGE=ghcr.io/endure-network/endure-subnet-miner:prod

NETUID=30
# For testnet use NETUID=504, CHAIN=test, SERVING_STAGE=testnet and candidate images.
CHAIN=finney
SERVING_STAGE=mainnet
EXTERNAL_IP=0.0.0.0
VALIDATOR_WALLET_ROOT=/path/to/validator-only-wallets
MINER_WALLET_ROOT=/path/to/miner-only-wallets
WALLET_NAME=replace-me
VALIDATOR_HOTKEY=replace-me
MINER_HOTKEY=replace-me
VALIDATOR_AXON_OVERRIDES=

MIN_MINER_STAKE=0
EPOCH_LENGTH=100
MARKET_DATA_ENDPOINT=wss://archive.chain.opentensor.ai:443
