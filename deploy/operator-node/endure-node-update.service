[Unit]
Description=Follow the Endure release channel
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=@DEPLOY_DIR@
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UnsetEnvironment=BASH_ENV ENV PYTHONPATH PYTHONHOME ENDURE_ENV_FILE DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG COMPOSE_FILE
ExecStart=/bin/bash -p "@DEPLOY_DIR@/deploy.sh"
