# Mainnet only after the adaptive image completes the staging soak/release gate.
# Copy to .env.three. Never put a mnemonic or key JSON in this file.
MINER_IMAGE=ghcr.io/endure-network/endure-subnet-adaptive-miner:prod
CHAIN=finney
NETUID=30
SERVING_STAGE=mainnet
EXTERNAL_IP=replace-me
MARKET_DATA_ENDPOINT=wss://archive.chain.opentensor.ai:443

# Give each container its own directory with only its hotkey and coldkeypub.txt.
# Register all three hotkeys separately on netuid 30 before starting miners.
MINER1_WALLET_ROOT=/opt/endure-secrets/adaptive-miner-1-wallets
MINER1_WALLET=endure-mainnet
MINER1_HOTKEY=miner-1

MINER2_WALLET_ROOT=/opt/endure-secrets/adaptive-miner-2-wallets
MINER2_WALLET=endure-mainnet
MINER2_HOTKEY=miner-2

MINER3_WALLET_ROOT=/opt/endure-secrets/adaptive-miner-3-wallets
MINER3_WALLET=endure-mainnet
MINER3_HOTKEY=miner-3
