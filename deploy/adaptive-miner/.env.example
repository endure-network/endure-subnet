# Mainnet settings. Do not put a mnemonic, coldkey, or hotkey JSON here.
# Deploy only a release promoted through staging and published to :prod.
MINER_IMAGE=ghcr.io/endure-network/endure-subnet-adaptive-miner:prod
CHAIN=finney
NETUID=30
SERVING_STAGE=mainnet
EXTERNAL_IP=replace-me
MINER_AXON_PORT=8092

# This directory should contain only the runtime wallet metadata and hotkey.
MINER_WALLET_ROOT=/opt/endure-secrets/miner-wallets
MINER_WALLET=endure-mainnet
MINER_HOTKEY=miner

# Replace this only with a trusted Bittensor mainnet archive endpoint.
MARKET_DATA_ENDPOINT=wss://archive.chain.opentensor.ai:443
